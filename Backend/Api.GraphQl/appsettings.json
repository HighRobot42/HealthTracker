{
  "BasePath": "/HealthTracker/GraphQl",
  "Service": {
    "Name": "HealthTracker.Api.GraphQl",
    "NameSpace": "BeCause",
    "Version": "1.0.0"
  },
  "ArbitrationSettings": {
    "TimeAllowedBetweenSuggestionAndMediationInDays": 2,
    "ReputationThresholdForArbitration": 100,
    "MaxMediationParticipants": 10,
    "RatingAppraisalReputationThreshold": 1000
  },
  "Engagement": {
    "ConsumerEnabled": true,
    "BatchSize": 1000,
    "BatchTimeoutMinutes": 5,
    "BufferEnabled": true,
    "BufferCapacity": 10000,
    "FlushBatchSize": 500,
    "FlushIntervalSeconds": 30
  },
  "IdentityServer": {
    "Authority": "https://localhost:5051"
    //"Authority": "http://localhost:5050"
  },
  "ServiceClientOptions": {
    "Authority": "https://localhost:5051",
    //"Authority": "http://localhost:5050"
    "ClientId": "healthtracker.graphql.client",
    "ClientSecret": "healthtracker-graphql-secret",
    "ExternalApis": {
      "ReputationSystem.Internal": {
        "ApiName": "ReputationSystem.Internal",
        "ApiUrl": "https://localhost:5023",
        //"ApiUrl": "http://localhost:5023",
        "Scopes": [
          "reputationSystem.internal.read"
        ]
      },
      "WikiEditor_Internal": {
        "ApiName": "WikiEditor.Internal",
        "ApiUrl": "https://localhost:5073",
        //"ApiUrl": "http://localhost:5072",
        "Scopes": [
          "wikiContent.internal.read"
        ]
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "User ID=postgres;Password=postgres;Host=localhost;Port=5432;Database=HealthTracker;Pooling=false",
    "HealthTrackerReadConnection": "User ID=postgres;Password=postgres;Host=localhost;Port=5432;Database=HealthTracker;Pooling=false",
    "HealthTrackerWriteConnection": "User ID=postgres;Password=postgres;Host=localhost;Port=5432;Database=HealthTracker;Pooling=false",
    "RabbitMq": "amqp://guest:guest@localhost:5672",
    "Redis": "localhost:6379"
  },
  "OpenTelemetry": {
    "TraceSamplingRatio": 1.0,
    "OtlpEndpoint": "http://localhost:4317",
    "EnablePrometheusExporter": false,
    "ServiceNamespace": "wicause",
    "ClusterName": "aks-platform-dev-weu-001",
    "K8sClusterName": "aks-platform-dev-weu-001",
    "CloudProvider": "azure",
    "CloudPlatform": "azure_aks"
  },
  "CorrelationOptions": {
    "IncludeInResponse": true,
    "LogCorrelationId": true,
    "LogUserId": true,
    "UpdateTraceIdentifier": true,
    "UsePublishFilterIfAvailable": true,
    "UseSendFilterIfAvailable": true
  },
  "AllowedHosts": "*"
}